<%= render "shared/errors" %>
<%= form_with(model: @article, local: true) do |f| %>
  <div class="flex flex-col justify-items-start">
    <div>
      <%= f.label :title %>
    </div>
    <div>
      <%= f.text_field :title %>
    </div>
    <div class="mt-4">
      <%= f.label :description %>
    </div>
    <div>
      <%= f.text_area :description %>
    </div>
    <div>
      <%= f.submit class: "btn-primary" %>
    </div>
  </div>
<% end %>