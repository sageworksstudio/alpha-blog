<div class="flex flex-col">
  <h1 class="font-sans text-3xl font-bold"><%= @article.title %></h1>
  <div class="p-12">
    <%= render "form" %>
  </div>
  
  <div class="mt-8">
    <p><%= link_to 'Delete this article', article_path(@article), class: "btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" } %></p>
    <p><%= link_to 'Back to all articles', articles_path, class: "btn-primary w-auto" %></p>
  </div>
</div>