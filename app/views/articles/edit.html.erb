<div class="flex flex-col">
  <h1 class="font-sans text-3xl font-bold"><%= @article.title %></h1>
  <div class="p-12">
    <%= render "form" %>
  </div>
  
  <div class="flex flex-row mt-8 justify-items-start space-x-4">
    <%= link_to 'Back to all articles', articles_path, class: "text-sky-600 bg-sky-100 p-2" %>
    <%= link_to 'Delete', article_path(@article), class: "text-red-600 bg-red-100 p-2", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" } %>
  </div>
</div>