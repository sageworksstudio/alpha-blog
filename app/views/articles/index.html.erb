<div class="flex flex-col">
  <h1 class="font-sans text-3xl">Articles</h1>
  <div class="grid grid-cols-4 gap-4 p-12">
    <% @articles.each do |article| %>
      <div class="border-2 p-4 bg-white">
          <p class="font-bold"><%= article.title %></p>
          <p><%= article.description %></p>
          <%= link_to 'Read More', article_path(article), class: "bg-sky-600 text-gray-100 px-8 py-4 rounded mt-4 inline-block" %>
          <div class="flex flex-row mt-8 justify-items-start space-x-4">
            <%= link_to 'Edit', edit_article_path(article), class: "text-yellow-600 p-2" %>
            <%= link_to 'Delete', article_path(article), class: "text-red-600 p-2", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" } %>
          </div>
      </div>
    <% end %>
  </div>
  <div class="flex">
    <%= link_to 'New Article', new_article_path, class: "bg-sky-600 text-gray-100 px-8 py-4 rounded" %>
  </div>
</div>
