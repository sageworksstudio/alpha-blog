<div class="flex flex-col">
  <h1 class="font-sans text-3xl">Articles</h1>
  <div class="grid grid-cols-4 gap-4 p-12">
    <% @articles.each do |article| %>
      <div class="border-2 p-4 bg-white">
          <p class="font-bold"><%= article.title %></p>
          <p><%= article.description %></p>
          <%= link_to 'Read More', article_path(article), class: "btn-primary" %>
          <p class="mt-4">Created <%= time_ago_in_words(article.created_at) %> ago, updated <%= time_ago_in_words(article.updated_at) %> ago.</p>
          <div class="flex flex-row mt-8 justify-items-start space-x-4">
            <%= link_to 'Edit', edit_article_path(article), class: "btn-warn" %>
            <%= link_to 'Delete', article_path(article), class: "btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" } %>
          </div>
      </div>
    <% end %>
  </div>
  <div class="flex">
    <%= link_to 'New Article', new_article_path, class: "btn-primary" %>
  </div>
</div>
