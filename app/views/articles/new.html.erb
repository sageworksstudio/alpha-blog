<div class="flex flex-col">
  <h1 class="text-2xl mb-8">Create a new article</h1>
  <%= form_with scope: :article, url: articles_path, local: true do |f| %>
    <div class="flex flex-col">
      <div>
        <%= f.label :title %>
      </div>
      <div>
        <%= f.text_field :title %>
      </div>
      <div>
        <%= f.label :description %>
      </div>
      <div>
        <%= f.text_area :description %>
      </div>
      <div class="bg-sky-400 inline-block p-4 text-slate-50 mt-8">
        <%= f.submit %>
      </div>
    </div>
  <% end %>
</div>