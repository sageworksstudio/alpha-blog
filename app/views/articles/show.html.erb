<div class="flex flex-col">
  <h1 class="font-sans text-3xl font-bold"><%= @article.title %></h1>
  <p class="mt-4"><%= @article.description %></p>
  <div class="p-12">
    <%# placeholder for article %>
    <%= link_to 'Back to all articles', articles_path, class: "btn-primary" %>
  </div>
  <div class="flex flex-row mt-8 justify-items-start space-x-4">
    <%= link_to 'Edit', edit_article_path(@article), class: "btn-warn" %>
    <%= link_to 'Delete', article_path(@article), class: "btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" } %>
  </div>
</div>
