<% if @article.errors.any? %>
  <div class="bg-red-100 inline-block p-2">
    <h2 class="text-xl text-red-900">The following errors prevented the article from being saved:</h2>
    <ul class="mb-4">
      <% @article.errors.full_messages.each do |msg| %>
        <li class="text-red-600"><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>